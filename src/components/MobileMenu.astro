---
import SocialLinks from './SocialLinks.astro';
import { useTranslations, asset, type Lang } from '../i18n';
import { images, contact, sections } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const links = [
  { id: sections.project, label: t.nav.project },
  { id: sections.newBuild, label: t.nav.newBuild },
  { id: sections.process, label: t.nav.process },
  { id: sections.surroundings, label: t.nav.surroundings },
  { id: sections.team, label: t.nav.team },
  { id: sections.contact, label: t.nav.contact },
];
---
<div class="menu anim-fade" id="mobile-menu" role="dialog" aria-modal="true" aria-label={t.nav.menu} hidden data-menu>
  <div class="menu__top">
    <img src={asset(images.logoWhite)} alt="Deluxe Design Properties" width="700" height="445" />
    <button type="button" class="menu__close" aria-label={t.nav.closeMenu} data-menu-close>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" /></svg>
    </button>
  </div>

  <nav class="menu__nav" aria-label={t.nav.menu}>
    {links.map((l, i) => (
      <a href={`#${l.id}`} class="menu__link" data-menu-close>
        <span class="menu__num">{String(i + 1).padStart(2, '0')}</span>
        <span class="menu__label">{l.label}</span>
      </a>
    ))}
  </nav>

  <div class="menu__bottom">
    <!-- Las llaves animadas: caen y se balancean cada vez que se abre el menú -->
    <div class="menu__keys" aria-hidden="true" data-menu-keys>
      <img class="menu__keys-img" src={asset(images.key)} alt="" width="900" height="879" />
    </div>
    <div class="menu__contact">
      <a href={contact.phoneHref} class="menu__phone">{contact.phone}</a>
      <SocialLinks label={t.nav.social} class="menu__social" />
    </div>
    <a href={`#${sections.dossier}`} class="btn btn--light menu__dossier" data-menu-close>{t.nav.dossier}</a>
  </div>
</div>

<script>
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const openers = document.querySelectorAll<HTMLButtonElement>('[data-menu-open]');
  if (menu) {
    const keys = menu.querySelector<HTMLElement>('[data-menu-keys]');
    let lastFocus: HTMLElement | null = null;

    const open = () => {
      lastFocus = document.activeElement as HTMLElement;
      menu.hidden = false;
      document.body.classList.add('is-locked');
      openers.forEach((b) => b.setAttribute('aria-expanded', 'true'));
      // Reinicia la animación de las llaves en cada apertura
      if (keys) { keys.classList.remove('is-animating'); void keys.offsetWidth; keys.classList.add('is-animating'); }
      menu.querySelector<HTMLElement>('[data-menu-close]')?.focus();
    };
    const close = () => {
      menu.hidden = true;
      document.body.classList.remove('is-locked');
      openers.forEach((b) => b.setAttribute('aria-expanded', 'false'));
      lastFocus?.focus({ preventScroll: true });
    };

    openers.forEach((b) => b.addEventListener('click', open));
    menu.querySelectorAll('[data-menu-close]').forEach((el) => el.addEventListener('click', close));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) close(); });
    // Si se agranda la ventana a escritorio con el menú abierto, se cierra
    matchMedia('(min-width: 1200px)').addEventListener('change', (e) => { if (e.matches && !menu.hidden) close(); });
  }
</script>

<style>
  .menu {
    position: fixed;
    inset: 0;
    z-index: 50;
    background: var(--c-ink);
    color: var(--c-white);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-bottom: env(safe-area-inset-bottom);
  }
  .menu[hidden] { display: none; }

  .menu__top {
    flex-shrink: 0;
    height: var(--header-h);
    padding: 0 var(--pad-x);
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--c-line-dark);
  }
  .menu__top img { height: 42px; width: auto; }
  .menu__close {
    width: 44px;
    height: 44px;
    border: 0;
    background: transparent;
    color: var(--c-white);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .menu__nav { flex: 1; padding: 24px var(--pad-x); display: flex; flex-direction: column; }
  .menu__link {
    display: flex;
    align-items: baseline;
    gap: 18px;
    padding: 13px 0;
    border-bottom: 1px solid var(--c-line-dark);
    color: var(--c-white);
    text-decoration: none;
  }
  .menu__link:hover { color: var(--c-gold); }
  .menu__num { min-width: 26px; font-size: 11px; font-weight: 600; letter-spacing: 0.2em; color: var(--c-gold); }
  .menu__label { font-family: var(--f-heading); font-weight: 500; font-size: 41px; line-height: 1.05; }

  .menu__bottom { padding: 0 var(--pad-x) 28px; display: flex; flex-direction: column; gap: 14px; }
  .menu__keys { pointer-events: none; }
  .menu__keys-img {
    width: 84px;
    transform-origin: 45% 5%;
    filter: drop-shadow(0 10px 18px rgba(0, 0, 0, 0.45));
  }
  .menu__keys.is-animating { animation: dd-drop 0.6s var(--ease-out) 0.15s both; }
  .menu__keys.is-animating .menu__keys-img { animation: dd-swing 2.4s ease-in-out 0.7s 2; }

  .menu__contact { display: flex; align-items: center; justify-content: space-between; }
  .menu__phone { color: var(--c-white); text-decoration: none; font-size: 19px; white-space: nowrap; }
  .menu__contact { gap: 8px; flex-wrap: wrap; }
  .menu__contact :global(.menu__social) { gap: 0; margin-right: -6px; }
  .menu__contact :global(.social__link) { width: 34px; }
  @media (min-width: 768px) { .menu__contact :global(.social__link) { width: 40px; } }
  .menu__dossier { height: 54px; margin-top: 6px; }

  @media (min-width: 768px) {
    .menu__top img { height: 50px; }
    .menu__nav { padding: 40px var(--pad-x); }
    .menu__link { gap: 24px; padding: 16px 0; }
    .menu__num { min-width: 28px; font-size: 12px; }
    .menu__label { font-size: 55px; }
    .menu__bottom { padding-bottom: 36px; }
    .menu__keys-img { width: 100px; }
    .menu__phone { font-size: 20px; }
    .menu__dossier { align-self: flex-start; }
  }
</style>
