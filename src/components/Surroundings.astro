
---
import { useTranslations, asset, type Lang } from '../i18n';
import { places, sections } from '../data/site';

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang).surroundings;
const items = t.places.map((p, i) => ({
  ...p,
  src: asset(places[i]),
}));
---

<section id={sections.surroundings} class="env" data-env>
  <!-- Imágenes de fondo -->
  {items.map((p, i) => (
    <img
      class:list={['env__bg', { 'is-active': i === 0 }]}
      src={p.src}
      alt={p.alt}
      loading={i === 0 ? 'eager' : 'lazy'}
      decoding="async"
      data-env-bg
    />
  ))}

  <!-- Oscurecimiento ligero para mantener la legibilidad -->
  <div class="env__overlay" aria-hidden="true"></div>

  <!-- Contenido alineado con el ancho máximo global -->
  <div class="env__inner container">
    <div class="env__top">
      <div class="env__intro">
        <span class="eyebrow env__eyebrow">{t.eyebrow}</span>

        <h2 class="env__title">
          {t.title} <em>{t.titleEm}</em>
        </h2>

        <p class="env__text">{t.text}</p>
      </div>

      <div class="env__current" aria-live="polite">
        <span class="env__place" data-env-title>
          {items[0].title}
        </span>

        <button
          type="button"
          class="btn btn--light env__cta"
          data-env-next
        >
          {t.cta}
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M4 12h16M14 6l6 6-6 6" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Navegación entre lugares -->
    <div class="env__tabs" role="tablist" aria-label={t.tablist}>
      {items.map((p, i) => (
        <button
          type="button"
          role="tab"
          class="env__tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          tabIndex={i === 0 ? 0 : -1}
          data-env-tab
          data-title={p.title}
        >
          <span class="env__tab-num">
            {String(i + 1).padStart(2, '0')}
          </span>
          <span class="env__tab-label">{p.label}</span>
        </button>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-env]').forEach((root) => {
    const bgs = [
      ...root.querySelectorAll<HTMLImageElement>('[data-env-bg]'),
    ];
    const tabs = [
      ...root.querySelectorAll<HTMLButtonElement>('[data-env-tab]'),
    ];
    const title = root.querySelector<HTMLElement>('[data-env-title]');
    const next = root.querySelector<HTMLButtonElement>('[data-env-next]');

    if (!bgs.length || !tabs.length || !title) return;

    let index = 0;

    const go = (i: number, focus = false) => {
      index = (i + tabs.length) % tabs.length;

      bgs.forEach((bg, k) => {
        bg.classList.toggle('is-active', k === index);
        bg.setAttribute('aria-hidden', String(k !== index));
      });

      tabs.forEach((tab, k) => {
        const active = k === index;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
      });

      title.textContent = tabs[index].dataset.title ?? '';

      if (focus) tabs[index].focus();
    };

    tabs.forEach((tab, k) => {
      tab.addEventListener('click', () => go(k));

      tab.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          go(index + 1, true);
        }

        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          go(index - 1, true);
        }

        if (event.key === 'Home') {
          event.preventDefault();
          go(0, true);
        }

        if (event.key === 'End') {
          event.preventDefault();
          go(tabs.length - 1, true);
        }
      });
    });

    next?.addEventListener('click', () => go(index + 1));

    go(0);
  });
</script>

<style>
  .env {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    width: 100%;
    height: 700px;
    overflow: hidden;
    background: var(--c-ink-soft);
    color: var(--c-white);
  }

  /* Imágenes a pantalla completa, sin zoom artificial */
  .env__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    transform: none;
    opacity: 0;
    transition: opacity 0.8s ease;
    pointer-events: none;
  }

  .env__bg.is-active {
    opacity: 1;
  }

  /* Overlay más claro y uniforme en todos los tamaños */
  .env__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(12, 11, 10, 0.22);
    pointer-events: none;
  }

  /* Contenedor global: respeta --body-width y --pad-x */
  .env__inner.container {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 36px;
    padding-top: 48px;
    padding-bottom: 36px;
  }

  .env__top {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .env__intro {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 640px;
  }

  .env__eyebrow {
    color: var(--c-on-dark-eyebrow);
  }

  .env__title {
    font-family: var(--f-heading);
    font-weight: 500;
    font-size: var(--fs-h2-xl);
    line-height: 1.05;
  }

  .env__title em {
    font-family: inherit;
    font-style: italic;
  }

  .env__text {
    max-width: 620px;
    color: var(--c-on-dark-light);
    font-size: calc(var(--fs-body) + 2px);
    line-height: 1.6;
  }

  .env__current {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }

  .env__place {
    font-family: var(--f-heading);
    font-size: 30px;
    font-style: italic;
    line-height: 1.1;
  }

  .env__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 54px;
    padding-inline: 28px;
    border: 0;
  }

  /* Pestañas */
  .env__tabs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px 12px;
  }

  .env__tab {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    min-width: 0;
    min-height: 48px;
    padding: 14px 0 0;
    border: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.4);
    background: transparent;
    color: rgba(255, 255, 255, 0.78);
    text-align: left;
    cursor: pointer;
    transition: color 0.25s ease, border-color 0.25s ease;
  }

  .env__tab:hover,
  .env__tab:focus-visible {
    color: var(--c-white);
  }

  .env__tab:focus-visible {
    outline: 2px solid var(--c-white);
    outline-offset: 5px;
  }

  .env__tab[aria-selected='true'] {
    border-top: 2px solid var(--c-social);
    color: var(--c-white);
  }

  .env__tab-num {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
  }

  .env__tab-label {
    font-size: 12px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  /* Tablet */
  @media (min-width: 768px) {
    .env {
      height: 760px;
    }

    .env__inner.container {
      gap: 48px;
      padding-top: 56px;
      padding-bottom: 48px;
    }

    .env__intro {
      gap: 22px;
    }

    .env__text {
      font-size: 23px;
    }

    .env__place {
      font-size: 34px;
    }

    .env__tab {
      flex-direction: row;
      align-items: baseline;
      gap: 10px;
    }

    .env__tab-label {
      font-size: 13px;
      letter-spacing: 0.1em;
    }
  }

  /* Escritorio */
  @media (min-width: 1200px) {
    .env {
      height: 780px;
    }

    .env__inner.container {
      gap: 56px;
      padding-top: 64px;
      padding-bottom: 56px;
    }

    .env__top {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
      gap: 64px;
    }

    .env__intro {
      flex: 1 1 auto;
    }

    .env__text {
      font-size: 24px;
    }

    .env__current {
      flex: 0 0 auto;
      align-items: flex-end;
      gap: 16px;
      text-align: right;
    }

    .env__place {
      font-size: 38px;
    }

    .env__tabs {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 16px;
    }

    .env__tab {
      gap: 10px;
      padding-top: 16px;
    }

    .env__tab-label {
      letter-spacing: 0.12em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .env__bg,
    .env__tab {
      transition: none;
    }
  }
</style>
