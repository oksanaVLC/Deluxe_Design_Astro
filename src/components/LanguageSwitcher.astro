---
import { languages, localizedHome, useTranslations, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const current = languages.find((l) => l.code === lang)!;
---
<div class="lang" data-lang-switcher>
  <button
    type="button"
    class="lang__toggle"
    aria-haspopup="true"
    aria-expanded="false"
    aria-controls="lang-panel"
    aria-label={`${t.nav.language}: ${current.name}`}
    data-lang-toggle
  >
    {current.label}
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
  </button>

  <div class="lang__panel anim-pop" id="lang-panel" hidden data-lang-panel>
    <span class="lang__notch" aria-hidden="true"></span>
    <div class="lang__head">
      <span>{t.nav.language}</span>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z" /></svg>
    </div>
    <ul class="lang__list">
      {languages.map((l) => (
        <li>
          <a
            class="lang__option"
            href={localizedHome(l.code)}
            hreflang={l.code}
            lang={l.code}
            aria-current={l.code === lang ? 'true' : undefined}
          >
            <span class="lang__names">
              <span class="lang__name">{l.name}</span>
              <span class="lang__code">{l.label}</span>
            </span>
            {l.code === lang && (
              <span class="lang__check" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#121212" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7" /></svg>
              </span>
            )}
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-lang-switcher]').forEach((root) => {
    const btn = root.querySelector<HTMLButtonElement>('[data-lang-toggle]')!;
    const panel = root.querySelector<HTMLElement>('[data-lang-panel]')!;
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
    };
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      setOpen(panel.hidden);
    });
    document.addEventListener('click', (e) => {
      if (!root.contains(e.target as Node)) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) { setOpen(false); btn.focus(); }
    });
  });
</script>

<style>
  .lang { position: relative; }
  .lang__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-width: 44px;
    height: 44px;
    padding: 0 6px;
    border: 0;
    background: transparent;
    color: var(--c-white);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.18em;
  }
  .lang__toggle[aria-expanded='true'] svg { transform: rotate(180deg); }
  .lang__toggle svg { transition: transform 0.25s ease; }

  .lang__panel {
    position: absolute;
    top: 64px;
    right: -92px;
    z-index: 40;
    width: 264px;
    padding: 10px;
    background: var(--c-stone);
    border: 1px solid rgba(134, 102, 74, 0.22);
    border-radius: var(--radius-panel);
    box-shadow: 0 30px 70px rgba(10, 9, 8, 0.38), 0 2px 6px rgba(10, 9, 8, 0.12);
    color: var(--c-ink);
    white-space: normal;
  }
  .lang__panel[hidden] { display: none; }
  .lang__notch {
    position: absolute;
    top: -7px;
    right: 112px;
    width: 12px;
    height: 12px;
    background: var(--c-stone);
    border-left: 1px solid rgba(134, 102, 74, 0.22);
    border-top: 1px solid rgba(134, 102, 74, 0.22);
    transform: rotate(45deg);
  }
  .lang__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 14px 12px;
    margin-bottom: 6px;
    border-bottom: 1px solid #ded5c8;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--c-accent);
  }
  .lang__list { display: flex; flex-direction: column; gap: 2px; }
  .lang__option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 54px;
    padding: 0 12px 0 14px;
    border-radius: 11px;
    color: var(--c-ink);
    text-decoration: none;
    transition: background 0.2s ease;
  }
  .lang__option:hover { background: #ece5da; color: var(--c-ink); }
  .lang__option[aria-current='true'],
  .lang__option[aria-current='true']:hover { background: var(--c-ink); color: var(--c-white); }
  .lang__names { display: flex; align-items: baseline; gap: 12px; }
  .lang__name { font-family: var(--f-heading); font-size: 28px; font-weight: 500; line-height: 1; }
  .lang__code { font-size: 10px; font-weight: 600; letter-spacing: 0.2em; color: var(--c-label); }
  .lang__option[aria-current='true'] .lang__code { color: #d9cbb5; }
  .lang__check {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--c-gold);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (min-width: 768px) {
    .lang__panel { top: 60px; right: -20px; width: 252px; }
    .lang__notch { right: 36px; }
  }
  @media (min-width: 1200px) {
    .lang__panel { top: 58px; }
    .lang__notch { right: 34px; }
    .lang__option { height: 52px; }
    .lang__name { font-size: 26px; }
  }
</style>
