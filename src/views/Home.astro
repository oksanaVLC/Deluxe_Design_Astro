---
// La página completa. Cada sección es un componente independiente:
// para quitar, mover o duplicar una sección basta con tocar esta lista.
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import MobileMenu from '../components/MobileMenu.astro';
import Intro from '../components/Intro.astro';
import WhyUs from '../components/WhyUs.astro';
import ProjectSlider from '../components/ProjectSlider.astro';
import Process from '../components/Process.astro';
import Surroundings from '../components/Surroundings.astro';
import Team from '../components/Team.astro';
import Contact from '../components/Contact.astro';
import Dossier from '../components/Dossier.astro';
import Footer from '../components/Footer.astro';
import type { Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
---
<BaseLayout lang={lang}>
  <Hero lang={lang} />
  <MobileMenu lang={lang} />
  <main>
    <Intro lang={lang} />
    <WhyUs lang={lang} />
    <ProjectSlider lang={lang} />
    <Process lang={lang} />
    <Surroundings lang={lang} />
    <Team lang={lang} />
    <Contact lang={lang} />
    <Dossier lang={lang} />
  </main>
  <Footer lang={lang} />
</BaseLayout>
